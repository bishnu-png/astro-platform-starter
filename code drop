<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>BPS Auto & Flight Showroom</title>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    body {
      margin: 0;
      font-family: 'Rubik', sans-serif;
      background: #f7f9fc;
      color: #333;
    }

    header {
      background: linear-gradient(to right, #1f1c2c, #928dab);
      color: white;
      text-align: center;
      padding: 2rem;
    }

    header h1 {
      margin: 0;
      font-size: 2.8rem;
    }

    header p {
      font-size: 1.2rem;
      margin-top: 0.5rem;
    }

    .section {
      padding: 2rem 1rem;
      max-width: 1200px;
      margin: auto;
    }

    .section h2 {
      font-size: 2rem;
      color: #444;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .card {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      transition: transform 0.3s;
    }

    .card:hover {
      transform: scale(1.03);
    }

    .card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }

    .card-content {
      padding: 1rem;
    }

    .card-content h3 {
      margin-top: 0;
      color: #007bff;
    }

    .price {
      color: green;
      font-weight: bold;
    }

    footer {
      background: #1f1c2c;
      color: white;
      text-align: center;
      padding: 1rem;
      margin-top: 3rem;
    }

    @media(max-width: 600px) {
      header h1 {
        font-size: 2rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>BPS Luxury Showroom</h1>
    <p>Presented by Shri Bishnu Prasad Sahoo</p>
  </header>

  <section class="section">
    <h2>🚗 Luxury Cars</h2>
    <div class="grid">
      <div class="card">
        <img src="https://www.topgear.com/sites/default/files/2023/10/Rolls-Royce-Ghost.jpg" alt="Rolls Royce Ghost">
        <div class="card-content">
          <h3>Rolls Royce Ghost</h3>
          <p>CSD Price: <span class="price">₹5.2 Cr</span></p>
          <p>On-Road Price: ₹6.8 Cr</p>
        </div>
      </div>
      <div class="card">
        <img src="https://imgd.aeplcdn.com/370x208/n/cw/ec/54359/mercedes-benz-s-class-exterior-right-front-three-quarter-8.jpeg" alt="Mercedes S-Class">
        <div class="card-content">
          <h3>Mercedes-Benz S-Class</h3>
          <p>CSD Price: <span class="price">₹1.2 Cr</span></p>
          <p>On-Road Price: ₹1.6 Cr</p>
        </div>
      </div>
      <div class="card">
        <img src="https://imgd.aeplcdn.com/370x208/n/cw/ec/39037/tesla-model-s-right-front-three-quarter.jpeg" alt="Tesla Model S">
        <div class="card-content">
          <h3>Tesla Model S</h3>
          <p>CSD Price: <span class="price">₹95 Lakh</span></p>
          <p>On-Road Price: ₹1.2 Cr</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>🛩 Private Jets</h2>
    <div class="grid">
      <div class="card">
        <img src="https://www.jetcraft.com/wp-content/uploads/2020/07/Phenom-300E-5.jpg" alt="Phenom 300E">
        <div class="card-content">
          <h3>Embraer Phenom 300E</h3>
          <p>CSD Price: <span class="price">₹33 Cr</span></p>
          <p>On-Road Price: ₹39 Cr</p>
        </div>
      </div>
      <div class="card">
        <img src="https://images.unsplash.com/photo-1621632439063-f8d6d4a289e6?auto=format&fit=crop&w=800&q=60" alt="Gulfstream G650">
        <div class="card-content">
          <h3>Gulfstream G650</h3>
          <p>CSD Price: <span class="price">₹90 Cr</span></p>
          <p>On-Road Price: ₹108 Cr</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>✈️ Commercial Flights</h2>
    <div class="grid">
      <div class="card">
        <img src="https://www.airplane-pictures.net/images/uploaded-images/2019/1/30/1111629.jpg" alt="Boeing 737 MAX">
        <div class="card-content">
          <h3>Boeing 737 MAX</h3>
          <p>CSD Price: <span class="price">₹760 Cr</span></p>
          <p>On-Road Price: ₹850 Cr</p>
        </div>
      </div>
      <div class="card">
        <img src="https://cdn.airplane-pictures.net/images/uploaded-images/2023/2/13/1529794.jpg" alt="Airbus A320neo">
        <div class="card-content">
          <h3>Airbus A320neo</h3>
          <p>CSD Price: <span class="price">₹710 Cr</span></p>
          <p>On-Road Price: ₹790 Cr</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2025 BPS Luxury Showroom | Curated by Shri Bishnu Prasad Sahoo</p>
  </footer>

</body>
</html>
